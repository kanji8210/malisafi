{
    "name": "malisafi/mls-plugin",
    "description": "Malisafi MLS - Multi Listing Service WordPress Plugin with Stripe Integration",
    "type": "wordpress-plugin",
    "keywords": ["wordpress", "plugin", "mls", "real-estate", "stripe", "subscriptions"],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Malisafi",
            "email": "support@malisafi.com"
        }
    ],
    "require": {
        "php": ">=7.2",
        "stripe/stripe-php": "^10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "yoast/phpunit-polyfills": "^1.0",
        "wp-phpunit/wp-phpunit": "^6.0",
        "mockery/mockery": "^1.5",
        "phpstan/phpstan": "^1.9",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^2.3"
    },
    "autoload": {
        "classmap": [
            "includes/",
            "admin/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MalisafiMLS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite='Unit Tests'",
        "test:integration": "phpunit --testsuite='Integration Tests'",
        "test:coverage": "phpunit --coverage-html tests/coverage",
        "phpcs": "phpcs --standard=WordPress includes/ admin/ public/",
        "phpcs:fix": "phpcbf --standard=WordPress includes/ admin/ public/",
        "phpstan": "phpstan analyse --level=5 includes/ admin/ public/",
        "post-install-cmd": [
            "@php -r \"echo '\\n✅ Stripe PHP library installed successfully!\\n';\""
        ],
        "post-update-cmd": [
            "@php -r \"echo '\\n✅ Dependencies updated successfully!\\n';\""
        ]
    },
    "scripts-descriptions": {
        "test": "Run all tests",
        "test:unit": "Run unit tests only",
        "test:integration": "Run integration tests only",
        "test:coverage": "Generate code coverage report",
        "phpcs": "Check code style",
        "phpcs:fix": "Fix code style issues",
        "phpstan": "Run static analysis"
    }
}
